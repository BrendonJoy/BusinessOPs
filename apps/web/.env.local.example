NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Sign up at https://resend.com — used to email quotes/invoices to customers.
# Until this is set, "Send" still marks the document as sent but skips the email.
RESEND_API_KEY=your-resend-api-key
# Must be an address on a domain you've verified in Resend. Their sandbox
# address (onboarding@resend.dev) only delivers to your own Resend account
# email, not real customers, so it's fine for testing but not for production.
RESEND_FROM_EMAIL=BusinessOps <onboarding@resend.dev>

# Google Cloud Console — used for job address geocoding, distance/routing
# calculations, and (later) address autocomplete. Server-side only key
# (Geocoding + Distance Matrix APIs); do NOT prefix with NEXT_PUBLIC_. If a
# client-side widget (e.g. Places autocomplete in a form) is added later,
# that needs a separate key restricted by HTTP referrer, not this one.
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
